{% if section.settings.enabled %}
<section class="pe-section">
  <div class="pe-shell">
    <div class="pe-final">
      {% if section.settings.image != blank %}
        <div class="pe-final__media">{{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '800,1200,1600,2200', alt: section.settings.heading }}</div>
      {% endif %}
      <div class="pe-final__copy">
        {% if section.settings.eyebrow != blank %}<p class="pe-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
        <a class="button" href="#PEProductForm-{{ section.settings.main_section_id | default: 'pe_main' }}">{{ section.settings.button_label }}</a>
      </div>
    </div>
  </div>
</section>
{% endif %}
{% schema %}
{"name":"PE final CTA","settings":[
{"type":"checkbox","id":"enabled","label":"Show section","default":true},
{"type":"image_picker","id":"image","label":"Background image"},
{"type":"text","id":"eyebrow","label":"Eyebrow"},
{"type":"text","id":"heading","label":"Heading","default":"Ready to choose your option?"},
{"type":"textarea","id":"text","label":"Text","default":"Return to the product selector to choose the variant that fits your needs."},
{"type":"text","id":"button_label","label":"Button label","default":"CHOOSE YOUR OPTION"},
{"type":"text","id":"main_section_id","label":"Main section ID","default":"pe_main"}
],"presets":[{"name":"PE final CTA"}]}
{% endschema %}