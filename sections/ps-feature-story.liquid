{%- render 'ps-assets' -%}
{%- assign s = section.settings -%}
<section
  class="ps-page ps-story ps-story--{{ s.layout }} ps-theme--{{ s.background }} ps-pad--{{ s.spacing }}"
  style="--ps-focal: {{ s.focal_x }}% {{ s.focal_y }}%;"
>
  <div class="ps-story__grid{% unless s.layout == 'media-full' %} ps-wrap{% endunless %}">
    <figure class="ps-media ps-story__media ps-reveal ps-reveal-media">
      {%- if s.layout == 'media-full' -%}
        {%- assign ps_sizes = '(min-width: 1320px) 1320px, 100vw' -%}
      {%- else -%}
        {%- assign ps_sizes = '(min-width: 990px) 55vw, 100vw' -%}
      {%- endif -%}
      {%- render 'ps-image',
        image: s.image,
        fallback: s.fallback_media,
        ps_product: product,
        alt: s.image_alt,
        sizes: ps_sizes
      -%}
    </figure>
    <div class="ps-story__text{% if s.layout == 'media-full' %} ps-wrap{% endif %} ps-reveal">
      {%- if s.eyebrow != blank -%}
        <p class="ps-eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- render 'ps-heading', text: s.heading, class: 'ps-heading--lg' -%}
      <div class="ps-body">{{ s.body }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PS · Feature story",
  "tag": "div",
  "class": "ps-shell",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "01 — Eye space" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "One visual line per line break.", "default": "More room\nfor your eyes." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Recessed 3D eye space is designed to keep the mask from sitting flat against your eyelids and lashes.</p>" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "fallback_media", "label": "Fallback: product media position", "info": "Used when no image is selected. 0 = none.", "min": 0, "max": 20, "step": 1, "default": 2 },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Front view of the Pillow-Side mask showing its two recessed eye cups" },
    { "type": "range", "id": "focal_x", "label": "Crop focus horizontal", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "focal_y", "label": "Crop focus vertical", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "layout", "label": "Layout", "default": "media-right",
      "options": [
        { "value": "media-right", "label": "Image right" },
        { "value": "media-left", "label": "Image left" },
        { "value": "media-full", "label": "Large image, text below" }
      ]
    },
    {
      "type": "select", "id": "background", "label": "Background", "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Warm off-white" },
        { "value": "stone", "label": "Soft neutral" },
        { "value": "night", "label": "Night" },
        { "value": "ink", "label": "Charcoal" }
      ]
    },
    {
      "type": "select", "id": "spacing", "label": "Vertical spacing", "default": "md",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ]
    }
  ],
  "presets": [{ "name": "PS · Feature story" }]
}
{% endschema %}
