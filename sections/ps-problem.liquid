{%- render 'ps-assets' -%}
<section class="ps-page ps-problem ps-theme--{{ section.settings.background }} ps-pad--{{ section.settings.spacing }}">
  <div class="ps-wrap ps-split">
    <div class="ps-split__text ps-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ps-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- render 'ps-heading', text: section.settings.heading, class: 'ps-heading--lg' -%}
      <div class="ps-body ps-body--story">{{ section.settings.body }}</div>
    </div>
    <div class="ps-split__media">
      <figure class="ps-media ps-media--natural ps-reveal ps-reveal-media">
        {%- render 'ps-image',
          image: section.settings.image,
          fallback: section.settings.fallback_media,
          ps_product: product,
          alt: section.settings.image_alt,
          sizes: '(min-width: 990px) 50vw, 100vw'
        -%}
      </figure>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PS · Problem",
  "tag": "div",
  "class": "ps-shell",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The side-sleeper problem" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "One visual line per line break.", "default": "Your mask works.\nUntil you roll over." },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Most sleep masks look perfectly comfortable when you're lying still.</p><p>Then you turn onto your side.</p><p>The pillow pushes against the mask. It shifts. A small gap can open around the nose. The eye area starts feeling crowded.</p><p>So you tighten the strap.</p><p><strong>Now you've solved one problem by creating another.</strong></p>"
    },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Comparison image" },
    { "type": "range", "id": "fallback_media", "label": "Fallback: product media position", "info": "Used when no image is selected. 0 = none.", "min": 0, "max": 20, "step": 1, "default": 7 },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Side-by-side comparison: an ordinary flat mask letting light in near the nose, and the Pillow-Side contoured mask sitting flush against the pillow" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "background", "label": "Background", "default": "cream",
      "options": [
        { "value": "cream", "label": "Warm off-white" },
        { "value": "white", "label": "White" },
        { "value": "stone", "label": "Soft neutral" },
        { "value": "night", "label": "Night" },
        { "value": "ink", "label": "Charcoal" }
      ]
    },
    {
      "type": "select", "id": "spacing", "label": "Vertical spacing", "default": "lg",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ]
    }
  ],
  "presets": [{ "name": "PS · Problem" }]
}
{% endschema %}
