<script>document.documentElement.classList.add('wm-product-template');document.body&&document.body.classList.add('wm-product-template');document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('wm-product-template')},{once:true});</script>
<header class="wm-local-header" role="banner">
  <div class="wm-local-header__inner">
    <a class="wm-local-header__brand" href="{{ routes.root_url }}" aria-label="Nubrae home">
      <img
        src="{{ 'nubraetm-wordmark.svg' | asset_url }}"
        class="wm-local-header__logo"
        alt="Nubrae™"
        width="560"
        height="150"
        loading="eager"
      >
    </a>

    <nav class="wm-local-header__nav" aria-label="Main navigation">
      <a href="/pages/faq">FAQ</a>
      <a href="/pages/contact">Contact</a>
      <a href="/pages/track-order">Track Order</a>
    </nav>

    <div class="wm-local-header__actions">
      <a href="{{ routes.search_url }}" aria-label="Search" class="wm-local-header__icon">⌕</a>
      <a href="{{ routes.cart_url }}" aria-label="Cart with {{ cart.item_count }} items" class="wm-local-header__cart">
        <span>Bag</span><sup>{{ cart.item_count }}</sup>
      </a>
    </div>
  </div>
</header>

{% style %}
  html.wm-product-template .shopify-section-group-header-group,
  body.wm-product-template .shopify-section-group-header-group{display:none!important}
  .wm-local-header{background:#fff;border-bottom:1px solid #e7e1da;color:#00304E;position:relative;z-index:25}
  @media(min-width:990px){html.wm-product-template .page-wrapper--drawer-open,body.wm-product-template .page-wrapper--drawer-open{margin-right:0!important}}
  .wm-local-header__inner{width:min(1240px,calc(100% - 40px));height:74px;margin:0 auto;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:24px}
  .wm-local-header__brand{color:inherit;text-decoration:none;justify-self:start;display:flex;align-items:center}
  .wm-local-header__logo{display:block;width:auto;height:43px;max-width:185px;object-fit:contain;object-position:left center}
  .wm-local-header__nav{display:flex;align-items:center;gap:28px;justify-content:center}
  .wm-local-header__nav a,.wm-local-header__actions a{color:inherit;text-decoration:none;font-size:12px;font-weight:700}
  .wm-local-header__nav a{letter-spacing:.03em}
  .wm-local-header__actions{display:flex;gap:18px;align-items:center;justify-self:end}
  .wm-local-header__icon{font-size:23px!important;line-height:1}
  .wm-local-header__cart{display:flex;align-items:center;gap:5px}
  .wm-local-header__cart sup{display:grid;place-items:center;background:#00304E;color:#fff;width:19px;height:19px;border-radius:50%;font-size:9px;line-height:1}
  @media(max-width:749px){.wm-local-header__inner{width:calc(100% - 28px);height:62px;grid-template-columns:1fr auto}.wm-local-header__nav{display:none}.wm-local-header__logo{height:36px;max-width:155px}.wm-local-header__actions{gap:13px}}
{% endstyle %}

{% schema %}
{
  "name":"Mattress topper header",
  "tag":"section",
  "class":"section-wm-minimal-header",
  "settings":[],
  "presets":[{"name":"Mattress topper header"}]
}
{% endschema %}
