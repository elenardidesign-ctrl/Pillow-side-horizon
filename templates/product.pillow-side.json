    "ps_faq": {
      "type": "ps-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Is Pillow-Side designed for side sleepers?",
            "answer": "<p>Yes. Its design centers on side and combination sleepers, particularly the places where a mask meets the pillow.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Will it touch my eyelashes?",
            "answer": "<p>The 3D eye area is designed to create additional clearance compared with a traditional flat mask.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Does it guarantee 100% blackout?",
            "answer": "<p>No. Fit varies by face shape, so we don't promise total blackout for everyone. The contoured design is intended to reduce common light-entry points when properly fitted.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Can I use it if I sleep on my back?",
            "answer": "<p>Yes. Side sleeping is the more demanding use case, but the mask can also be worn while sleeping on your back.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Is it weighted?",
            "answer": "<p>No. Pillow-Side is not a weighted sleep mask.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Is this a treatment for insomnia?",
            "answer": "<p>No. Pillow-Side is a sleep accessory designed to create a darker, more comfortable sleep environment. It is not a medical device or treatment.</p>"
          }
        }
      },
