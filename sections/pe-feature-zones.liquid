{% if section.settings.enabled %}
<section class="pe-section pe-section--soft">
  <div class="pe-shell pe-zones">
    <div class="pe-zones__image">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600,900,1200,1600,1800', alt: section.settings.heading }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag }}
      {% endif %}
    </div>
    <div>
      <div class="pe-heading">
        {% if section.settings.eyebrow != blank %}<p class="pe-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.description != blank %}<p>{{ section.settings.description }}</p>{% endif %}
      </div>
      <div class="pe-zones__list">
        {% for block in section.blocks %}
          <article class="pe-zone" {{ block.shopify_attributes }}>
            {% if block.settings.marker != blank %}<span class="pe-zone__index">{{ block.settings.marker }}</span>{% endif %}
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}
{% schema %}
{"name":"PE feature zones","settings":[
{"type":"checkbox","id":"enabled","label":"Show section","default":true},
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Designed with intention"},
{"type":"text","id":"heading","label":"Heading","default":"One product. Multiple thoughtful details."},
{"type":"textarea","id":"description","label":"Description","default":"Use this section to explain the product architecture without relying on vague claims."},
{"type":"image_picker","id":"image","label":"Main image"}
],"blocks":[{"type":"zone","name":"Feature or zone","limit":5,"settings":[
{"type":"text","id":"marker","label":"Marker","default":"01"},
{"type":"text","id":"title","label":"Title","default":"Feature title"},
{"type":"textarea","id":"description","label":"Description","default":"Explain what this part of the product does and why it matters."}
]}],"presets":[{"name":"PE feature zones","blocks":[{"type":"zone"},{"type":"zone","settings":{"marker":"02"}},{"type":"zone","settings":{"marker":"03"}}]}]}
{% endschema %}