{{ 'wm-product-landing.css' | asset_url | stylesheet_tag }}
{{ 'wm-research-copy.css' | asset_url | stylesheet_tag }}
{{ 'wm-research-integrity.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wm-product-landing.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign wm_product = product
  assign current_variant = wm_product.selected_or_first_available_variant
  assign form_id = 'WMProductForm-' | append: section.id
%}

<section class="wm-page" data-wm-product data-section-id="{{ section.id }}">
  {% if section.settings.promo_text != blank %}
    <div class="wm-promo" role="status">
      <span>{{ section.settings.promo_text }}</span>
    </div>
  {% endif %}

  <div class="wm-shell wm-buybox-shell">
    <div class="wm-gallery" data-wm-gallery>
      <div class="wm-gallery__stage">
        {% if wm_product.media.size > 0 %}
          {% for media in wm_product.media %}
            <div class="wm-gallery__item{% if forloop.first %} is-active{% endif %}" data-media-id="{{ media.id }}" {% unless forloop.first %}hidden{% endunless %}>
              {% case media.media_type %}
                {% when 'image' %}
                  {{ media | image_url: width: 1600 | image_tag: loading: 'eager', widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 990px) 58vw, 100vw', class: 'wm-gallery__media', alt: media.alt | default: wm_product.title }}
                {% when 'video' %}
                  {{ media | video_tag: controls: true, autoplay: false, loop: false, muted: false, class: 'wm-gallery__media wm-gallery__video' }}
                {% when 'external_video' %}
                  {{ media | external_video_tag: class: 'wm-gallery__media wm-gallery__video' }}
                {% else %}
                  {{ media | media_tag: class: 'wm-gallery__media' }}
              {% endcase %}
            </div>
          {% endfor %}
        {% else %}
          <div class="wm-gallery__item is-active wm-gallery__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'wm-gallery__media placeholder-svg' }}
          </div>
        {% endif %}
      </div>

      {% if wm_product.media.size > 1 %}
        <div class="wm-gallery__thumbs" aria-label="Product media">
          {% for media in wm_product.media limit: 8 %}
            <button type="button" class="wm-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-wm-thumb data-media-id="{{ media.id }}" aria-label="View media {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
              {% if media.preview_image %}
                {{ media.preview_image | image_url: width: 220 | image_tag: loading: 'lazy', class: 'wm-gallery__thumb-image', alt: media.alt | default: wm_product.title }}
              {% endif %}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <aside class="wm-buybox" aria-label="Purchase {{ wm_product.title | escape }}">
      {% if section.settings.eyebrow != blank %}
        <p class="wm-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      <h1 class="wm-product-title">{{ wm_product.title }}</h1>

      {% if section.settings.subtitle != blank %}
        <p class="wm-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}

      {% if section.settings.preprice_note != blank %}
        <p class="wm-offer-preprice">{{ section.settings.preprice_note }}</p>
      {% endif %}

      <div class="wm-price" data-wm-price-wrap>
        <span class="wm-price__current" data-wm-price>{{ current_variant.price | money }}</span>
      </div>

      <ul class="wm-benefits" role="list">
        <li><span aria-hidden="true">✓</span> {{ section.settings.benefit_1 }}</li>
        <li><span aria-hidden="true">✓</span> {{ section.settings.benefit_2 }}</li>
        <li><span aria-hidden="true">✓</span> {{ section.settings.benefit_3 }}</li>
        <li><span aria-hidden="true">✓</span> {{ section.settings.benefit_4 }}</li>
      </ul>

      {% form 'product', wm_product, id: form_id, class: 'wm-form' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-wm-variant-id>

        {% unless wm_product.has_only_default_variant %}
          <div class="wm-options" data-wm-options>
            {% for option in wm_product.options_with_values %}
              <fieldset class="wm-option" data-option-index="{{ forloop.index0 }}">
                <legend>{{ option.name }}</legend>
                <div class="wm-option__values">
                  {% for value in option.values %}
                    <button
                      type="button"
                      class="wm-option__button{% if option.selected_value == value %} is-selected{% endif %}"
                      data-wm-option
                      data-option-index="{{ forloop.parentloop.index0 }}"
                      data-option-value="{{ value | escape }}"
                      aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                    >{{ value }}</button>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}
          </div>
        {% endunless %}

        <div class="wm-purchase-row">
          <div class="wm-qty" aria-label="Quantity selector">
            <button type="button" data-wm-qty-minus aria-label="Decrease quantity">−</button>
            <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity" data-wm-qty-input>
            <button type="button" data-wm-qty-plus aria-label="Increase quantity">+</button>
          </div>

          <button type="submit" name="add" class="wm-atc" data-wm-atc {% unless current_variant.available %}disabled{% endunless %}>
            <span data-wm-atc-text>{% if current_variant.available %}{{ section.settings.cta_label }}{% else %}Sold out{% endif %}</span>
          </button>
        </div>
      {% endform %}

      <p class="wm-stock{% unless current_variant.available %} is-sold-out{% endunless %}" data-wm-stock>
        <span class="wm-stock__dot" aria-hidden="true"></span>
        {% if current_variant.available %}Available{% else %}Currently unavailable{% endif %}
      </p>

      <div class="wm-trust-row" role="list" aria-label="Purchase assurances">
        <div role="listitem"><strong>Secure checkout</strong><span>Protected payment</span></div>
        <div role="listitem"><strong>Tracked shipping</strong><span>Order updates</span></div>
        <div role="listitem"><strong>Clear returns</strong><span>Current store policy</span></div>
      </div>

      <div class="wm-accordions">
        <details open>
          <summary>What CloudLoft is for <span aria-hidden="true">+</span></summary>
          <div class="wm-accordion-content">
            <p>A quilted fiber-filled topper designed to add cushioning to a bed that feels too firm. It is not a replacement mattress and it does not repair structural sagging underneath.</p>
          </div>
        </details>
        <details>
          <summary>Sizing & fit <span aria-hidden="true">+</span></summary>
          <div class="wm-accordion-content"><p>Measure how deep your mattress is before you order, pillow top included, and check it against the size you are choosing. The usual reason a topper slides is corner straps instead of a skirt that grips all four sides. If it does not sit right on your bed, send it back; we would rather have the return than the one-star review.</p></div>
        </details>
        <details>
          <summary>Shipping & returns <span aria-hidden="true">+</span></summary>
          <div class="wm-accordion-content"><p>{{ section.settings.shipping_text }}</p>{% if shop.refund_policy %}<p><a href="{{ shop.refund_policy.url }}">View current store return policy</a></p>{% endif %}</div>
        </details>
      </div>

      <script type="application/json" data-wm-variants>{{ wm_product.variants | json }}</script>
      <script type="application/json" data-wm-product-media>{{ wm_product.media | json }}</script>
      <span data-wm-currency hidden>{{ cart.currency.iso_code | default: shop.currency }}</span>
    </aside>
  </div>

  <section class="wm-section wm-proof-intro" id="proof-1">
    <div class="wm-shell wm-proof-recognition">
      <div class="wm-proof-media">
        {% if section.settings.problem_image != blank %}
          {{ section.settings.problem_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', alt: section.settings.problem_heading }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
      <div class="wm-proof-copy">
        <p class="wm-kicker">01 — The bed you already know</p>
        <h2>{{ section.settings.problem_heading }}</h2>
        <p>{{ section.settings.problem_body }}</p>
        <div class="wm-voice-grid">
          <div class="wm-voice-card"><strong>A hollow where you sleep.</strong><span>You rotate the mattress. It feels fine for a night or two. Then the dip comes back.</span></div>
          <div class="wm-voice-card"><strong>You wake up sore before the day has started.</strong><span>The bed already feels worn out, but replacing it is not the decision you are making right now.</span></div>
          <div class="wm-voice-card"><strong>The last topper went flat.</strong><span>It looked thick out of the package, then packed down until you could barely tell it was there.</span></div>
          <div class="wm-voice-card"><strong>You are tired of buying the feeling of a solution.</strong><span>This time, the page should show you what is actually inside before asking you to buy.</span></div>
        </div>
        <p class="wm-release-line">None of that was your fault. You were buying thickness, because thickness is the only thing anyone ever showed you.</p>
      </div>
    </div>
  </section>

  <section class="wm-section wm-belief" id="proof-2">
    <div class="wm-shell wm-belief__inner">
      <div class="wm-belief__media">
        {% if section.settings.mechanism_image != blank %}
          {{ section.settings.mechanism_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', alt: section.settings.mechanism_heading }}
        {% else %}
          {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
      <div class="wm-belief__copy">
        <p class="wm-kicker">02 — Why the last one went flat</p>
        <h2>{{ section.settings.mechanism_heading }}</h2>
        <p>{{ section.settings.mechanism_body }}</p>
        <div class="wm-belief-points">
          <div class="wm-belief-point"><strong>Thickness tells you how tall it looks.</strong><span>With fiber fill, part of that initial height is air. Air compresses. The amount of material left behind is what matters after the first nights.</span></div>
          <div class="wm-belief-point"><strong>Weight tells you how much material is actually there.</strong><span>Fill weight is not a number anyone is required to print on a topper label in the United States. Fiber content is regulated. The amount of it is not. So the number that decides whether the product survives is the one number nobody has to show you — which is exactly why nobody does.</span></div>
          <div class="wm-belief-point"><strong>Stitching decides whether the filling can move away from you.</strong><span>Filling that can move, moves. In one open pocket your body pushes it sideways every time you turn over. Within weeks it is heaped at the edges and thin where your hip sits. That is the ridge down the middle people describe, and you can check it with your hand on any topper.</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="wm-section wm-changes" id="proof-2b">
    <div class="wm-shell">
      <div class="wm-changes__heading">
        <p class="wm-kicker">02b — What changes, and what doesn't</p>
        <h2>What you actually get from a comfort layer.</h2>
      </div>
      <div class="wm-changes__grid">
        <article class="wm-change-card wm-change-card--primary">
          <strong>What changes</strong>
          <ul>
            <li>A bed that feels too firm stops pressing back at your hips and shoulders.</li>
            <li>You stop feeling as much of the mattress structure through the sheet — the springs, the edge, the hard seam you have been sleeping around.</li>
            <li>The layer is fiber rather than foam, so it does not hold heat the way foam does.</li>
          </ul>
        </article>
        <article class="wm-change-card">
          <strong>What does not change</strong>
          <ul>
            <li>The structure underneath. If the mattress is broken, it is still broken in the morning.</li>
            <li>A hollow already formed in the core stays there. Anyone who tells you otherwise is selling you something.</li>
            <li>We claim nothing about pain, sleep quality or health. This is a comfort layer, and we would rather say that than stretch it.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="wm-section wm-proof-lab" id="proof-3">
    <div class="wm-shell">
      <div class="wm-proof-lab__intro">
        <p class="wm-kicker">03 — How to judge any topper, including this one</p>
        <h2>{{ section.settings.proof_heading }}</h2>
        <p>{{ section.settings.proof_body }}</p>
      </div>
      <div class="wm-proof-grid">
        <article class="wm-proof-card">
          <div class="wm-proof-card__media">
            {% if section.settings.scale_image != blank %}
              {{ section.settings.scale_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Mattress topper on a scale' }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          <div class="wm-proof-card__copy"><span>Test 01</span><h3>Put it on a scale.</h3><p>Use a bathroom scale, out of the package, with nothing else on it. You are weighing material, because air weighs nothing. Whatever that number is, it is the part that survives the first night.</p></div>
        </article>
        <article class="wm-proof-card">
          <div class="wm-proof-card__media">
            {% if section.settings.cut_image != blank %}
              {{ section.settings.cut_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Quilted mattress topper construction' }}
            {% else %}
              {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          <div class="wm-proof-card__copy"><span>Test 02</span><h3>Push your hand into it.</h3><p>Press into the middle of a quilted square, then into a seam, and feel where the filling stops. Closed compartments hold the fill over the part of the bed that carries you. One large open pocket lets it travel, which is how a topper ends up thick at the edges and thin under your hip.</p></div>
        </article>
        <article class="wm-proof-card">
          <div class="wm-proof-card__media">
            {% if section.settings.measure_image != blank %}
              {{ section.settings.measure_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Mattress topper beside a tape measure' }}
            {% else %}
              {{ 'product-3' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          <div class="wm-proof-card__copy"><span>Test 03</span><h3>Measure it after a month.</h3><p>Not out of the box; out of the box everything is tall. Put a tape on it after thirty nights in the same spot. That is the only measurement that describes what you actually bought.</p></div>
        </article>
      </div>
    </div>
  </section>

  <section class="wm-spec-strip">
    <div class="wm-shell wm-spec-grid wm-spec-grid--research">
      <div><strong>WEIGH IT</strong><span>Material, not air</span></div>
      <div><strong>FEEL IT</strong><span>Find where the filling stops</span></div>
      <div><strong>MEASURE IT LATER</strong><span>Judge it after use</span></div>
    </div>
  </section>

  <section class="wm-guarantee" id="proof-4">
    <div class="wm-shell wm-guarantee__inner">
      <div>
        <p class="wm-kicker">04 — A guarantee you can check yourself.</p>
        <h2>{{ section.settings.guarantee_heading }}</h2>
        <p>{{ section.settings.guarantee_body }}</p>
        {% if shop.refund_policy %}<a class="wm-secondary-cta" href="{{ shop.refund_policy.url }}">VIEW CURRENT RETURN POLICY</a>{% endif %}
      </div>
      <div class="wm-guarantee__checks" role="list">
        <div role="listitem"><span>✓</span> If it goes flat where you sleep, that is the test.</div>
        <div role="listitem"><span>✓</span> Send a photo. No measurement to prove.</div>
        <div role="listitem"><span>✓</span> No clause about whether you rotated it enough.</div>
      </div>
    </div>
  </section>

  <section class="wm-section wm-value" id="proof-5">
    <div class="wm-shell wm-value__inner">
      <div class="wm-value__copy">
        <p class="wm-kicker">05 — The decision for this year</p>
        <h2>{{ section.settings.value_heading }}</h2>
        <p>{{ section.settings.value_body }}</p>
        <div class="wm-value__compare">
          <div class="wm-value-box wm-value-box--primary"><small>Nubrae™ CloudLoft</small><strong>$199</strong><span>A comfort layer for the bed you are keeping now.</span></div>
          <div class="wm-value-box"><small>Average Queen mattress</small><strong>~$1,000</strong><span>The larger purchase you can make when you are ready.</span></div>
        </div>
        <div class="wm-limit"><strong>What CloudLoft will not do:</strong> if the mattress underneath is structurally sagging, a topper will not repair it. CloudLoft is designed to make the surface more comfortable to sleep on while you save for the replacement.</div>
        <a class="wm-anchor-cta" href="#{{ form_id }}">CHOOSE YOUR SIZE</a>
      </div>
      <div class="wm-value__media">
        {% if section.settings.value_image != blank %}
          {{ section.settings.value_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', alt: section.settings.value_heading }}
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>
  </section>

  <section class="wm-section wm-research-block">
    <div class="wm-shell">
      <div class="wm-research-block__intro">
        <p class="wm-kicker">From the research</p>
        <h2>What people complain about after buying other toppers.</h2>
        <p class="wm-research-block__disclaimer">These are not Nubrae reviews. CloudLoft has not shipped, so it has no customers and no ratings, and we are not going to invent any. These are real, unedited public reviews of OTHER mattress toppers, collected during our research. Spelling is theirs.</p>
      </div>
      <div class="wm-research-block__grid">
        <blockquote class="wm-research-quote"><p>“I'm considering a mattress topper because I can't afford another mattress!”</p><cite>Mumsnet forum</cite></blockquote>
        <blockquote class="wm-research-quote"><p>“Don't waste your time. It's fluffy, but packs down to nothing once you lay on it.”</p><cite>ProductReview — Muscle Mat — one-star review</cite></blockquote>
        <blockquote class="wm-research-quote"><p>“The picture is deceiving as to the 'fluffy-ness' of the pad.”</p><cite>Walmart — U by Bedsure — two-star review</cite></blockquote>
        <blockquote class="wm-research-quote"><p>“While it came with straps attached at each corner, they won't stay put.”</p><cite>Walmart — Extra Firm topper — two-star review</cite></blockquote>
        <blockquote class="wm-research-quote"><p>“The topper doesn't hold its shape It is depressed on both sides where we sleep”</p><cite>ProductReview — Super Sleeper Pro — two-star review</cite></blockquote>
        <blockquote class="wm-research-quote"><p>“So in other words, in the small print, the mattress is guaranteed to dip, will continue to dip and they accept this.”</p><cite>Mumsnet forum</cite></blockquote>
      </div>
    </div>
  </section>

  <section class="wm-section wm-faq">
    <div class="wm-shell wm-faq__layout">
      <div class="wm-section-heading wm-section-heading--left">
        <p class="wm-kicker">Before you order</p>
        <h2>{{ section.settings.faq_heading }}</h2>
        <p>Straight answers. The product should not need vague promises.</p>
      </div>
      <div class="wm-faq__list">
        <details open><summary>What does CloudLoft actually do?<span>+</span></summary><p>It adds a quilted fiber layer on top of the mattress you already own. The point is cushioning for a bed that feels too firm. It does not repair a broken or structurally sagging mattress.</p></details>
        <details><summary>Why are you talking about weight instead of thickness?<span>+</span></summary><p>With fiber-filled toppers, visible height includes air that compresses under use. Weight tells you how much material is actually present, and that amount is not something a topper label has to show you.</p></details>
        <details><summary>Why does the quilting matter?<span>+</span></summary><p>Filling that can travel can move away from the places that carry repeated load. Press into the middle of a quilted area and then into a seam; you can feel where the filling stops.</p></details>
        <details><summary>Is this memory foam?<span>+</span></summary><p>No. CloudLoft is fiber-filled, not memory foam. It does not hold heat the way foam does.</p></details>
        <details><summary>Can I machine wash it?<span>+</span></summary><p>Yes. CloudLoft is fiber-filled rather than foam, so it can be machine washed. Follow the care label attached to the topper for the cycle and drying instructions.</p></details>
        <details><summary>What happens if it goes flat?<span>+</span></summary><p>If it goes flat where you sleep, that is the test. Send a photo. You do not need to prove a hidden measurement or argue about whether you rotated it enough.</p></details>
        <details><summary>Will this fix the sag in my mattress?<span>+</span></summary><p>No, and we would rather lose the sale than pretend otherwise. A topper sits on the deformation and follows it. If the core is gone, this makes the surface comfortable while you save for the replacement, and that is the honest description of what you are buying.</p></details>
        <details><summary>Which sizes are available?<span>+</span></summary><p>The size selector above shows the sizes currently offered. Match the size to your mattress width and length, then measure the mattress depth with the pillow top included before you order.</p></details>
        <details><summary>Will it stay on the bed?<span>+</span></summary><p>Measure how deep your mattress is before you order, pillow top included, and check it against the size you are choosing. The usual reason a topper slides is corner straps instead of a skirt that grips all four sides. If it does not sit right on your bed, send it back; we would rather have the return than the one-star review.</p></details>
        <details><summary>Why should I believe any of this?<span>+</span></summary><p>Do not. Run the three tests above on this topper and on the one you already own. If the argument on this page is right, you can tell without us.</p></details>
      </div>
    </div>
  </section>

  <div class="wm-mobile-bar" data-wm-mobile-bar>
    <div><strong>{{ current_variant.price | money }}</strong><small>{{ wm_product.title | truncate: 34 }}</small></div>
    <button type="button" data-wm-mobile-atc {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}{{ section.settings.cta_label }}{% else %}Sold out{% endif %}</button>
  </div>
</section>

{% schema %}
{
  "name": "Mattress topper landing",
  "tag": "section",
  "class": "section-wm-product-landing",
  "settings": [
    {"type":"text","id":"promo_text","label":"Promo bar","default":"For the mattress you're keeping this year."},
    {"type":"text","id":"eyebrow","label":"Product eyebrow","default":"For people who already bought a topper that went flat."},
    {"type":"textarea","id":"subtitle","label":"Product subtitle","default":"CloudLoft is built around two things you can verify before you buy: how much material is actually inside, and whether it stays where it was put."},
    {"type":"textarea","id":"preprice_note","label":"Pre-price reassurance","default":"If it goes flat where you sleep, send a photo. The guarantee is written around what you can see, not a hidden measurement."},
    {"type":"text","id":"benefit_1","label":"Benefit 1","default":"Judge it by weight, not just thickness"},
    {"type":"text","id":"benefit_2","label":"Benefit 2","default":"Check where the fill stops with your hand"},
    {"type":"text","id":"benefit_3","label":"Benefit 3","default":"Fiber fill. Not memory foam."},
    {"type":"text","id":"benefit_4","label":"Benefit 4","default":"Designed to add cushioning to a bed that feels too firm"},
    {"type":"text","id":"cta_label","label":"Add to cart label","default":"ADD TO CART"},
    {"type":"textarea","id":"shipping_text","label":"Shipping copy","default":"Orders use the shipping method shown at checkout. Return eligibility follows the current store return policy linked below."},

    {"type":"header","content":"Proof 1 — Customer problem"},
    {"type":"image_picker","id":"problem_image","label":"Problem section image"},
    {"type":"text","id":"problem_heading","label":"Problem heading","default":"You rotate it. The dip comes back."},
    {"type":"textarea","id":"problem_body","label":"Problem body","default":"Maybe it is a hollow where you sleep. Maybe the bed feels too firm. Maybe you already bought a topper that looked thick for a week and then went flat. This page is for the person who is keeping the mattress this year and wants to see proof before buying another topper."},

    {"type":"header","content":"Proof 2 — Mechanism and belief"},
    {"type":"image_picker","id":"mechanism_image","label":"Mechanism section image"},
    {"type":"text","id":"mechanism_heading","label":"Mechanism heading","default":"A topper is a weight product sold like a thickness product."},
    {"type":"textarea","id":"mechanism_body","label":"Mechanism body","default":"The height you see out of the package includes air. Air compresses. What remains is the material that was actually inside. Then there is a second question: can that material stay under you, or can it migrate away from the place your body loads every night?"},

    {"type":"header","content":"Proof 3 — Reader tests"},
    {"type":"text","id":"proof_heading","label":"Proof heading","default":"Three tests. Run them on ours, and on the one you already own."},
    {"type":"textarea","id":"proof_body","label":"Proof body","default":"We are not asking you to trust an adjective. These are the three things that decide whether a topper is still doing its job in three months. They take about two minutes each, and they work on any brand, including this one."},
    {"type":"image_picker","id":"scale_image","label":"Scale test image"},
    {"type":"image_picker","id":"cut_image","label":"Feel test image"},
    {"type":"image_picker","id":"measure_image","label":"Later measurement image"},

    {"type":"header","content":"Proof 4 — Guarantee"},
    {"type":"text","id":"guarantee_heading","label":"Guarantee heading","default":"If it goes flat, the guarantee should not turn into an argument."},
