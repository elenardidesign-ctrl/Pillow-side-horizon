{% if section.settings.enabled %}
<section class="pe-section pe-section--dark">
  <div class="pe-shell">
    <div class="pe-heading">
      {% if section.settings.eyebrow != blank %}<p class="pe-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}<p>{{ section.settings.intro }}</p>{% endif %}
    </div>
    <div class="pe-authority__grid">
      {% for block in section.blocks %}
        <article class="pe-authority-card" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.body }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
{% schema %}
{"name":"PE authority","settings":[
{"type":"checkbox","id":"enabled","label":"Show section","default":true},
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Why it works"},
{"type":"text","id":"heading","label":"Heading","default":"A clearer way to understand the product."},
{"type":"textarea","id":"intro","label":"Intro","default":"Use evidence-backed product information here. Leave medical or certification claims out unless you can substantiate them."}
],"blocks":[{"type":"point","name":"Information point","limit":4,"settings":[
{"type":"text","id":"title","label":"Title","default":"Product principle"},
{"type":"textarea","id":"body","label":"Body","default":"Explain a material, construction choice, mechanism, or other verifiable product detail."}
]}],"presets":[{"name":"PE authority","blocks":[{"type":"point"},{"type":"point"},{"type":"point"},{"type":"point"}]}]}
{% endschema %}