{% if section.settings.enabled %}
<section class="pe-section pe-section--soft">
  <div class="pe-shell">
    <div class="pe-heading">
      {% if section.settings.eyebrow != blank %}<p class="pe-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}<p>{{ section.settings.intro }}</p>{% endif %}
    </div>
    <div class="pe-feature-cards__grid">
      {% for block in section.blocks %}
        <article class="pe-feature-card" {{ block.shopify_attributes }}>
          <div class="pe-feature-card__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500,800,1200', alt: block.settings.title }}
            {% else %}
              {{ 'product-2' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <div class="pe-feature-card__body">
            {% if block.settings.badge != blank %}<span class="pe-feature-card__badge">{{ block.settings.badge }}</span>{% endif %}
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
            {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">Learn more</a>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
{% schema %}
{"name":"PE feature cards","settings":[
{"type":"checkbox","id":"enabled","label":"Show section","default":true},
{"type":"text","id":"eyebrow","label":"Eyebrow"},
{"type":"text","id":"heading","label":"Heading","default":"Details worth seeing up close."},
{"type":"textarea","id":"intro","label":"Intro"}
],"blocks":[{"type":"card","name":"Feature card","limit":4,"settings":[
{"type":"image_picker","id":"image","label":"Image"},
{"type":"text","id":"badge","label":"Badge"},
{"type":"text","id":"title","label":"Title","default":"Feature title"},
{"type":"textarea","id":"description","label":"Description","default":"Add a concise, product-specific explanation."},
{"type":"url","id":"link","label":"Optional link"}
]}],"presets":[{"name":"PE feature cards","blocks":[{"type":"card"},{"type":"card"}]}]}
{% endschema %}