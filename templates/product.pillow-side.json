    "ps_problem": {
      "type": "ps-problem",
      "settings": {
        "eyebrow": "The side-sleeper problem",
        "heading": "Your mask works.\nUntil you roll over.",
        "body": "<p>Most sleep masks look perfectly comfortable when you're lying still.</p><p>Then you turn onto your side.</p><p>The pillow pushes against the mask. It shifts. A small gap can open around the nose. The eye area starts feeling crowded.</p><p>So you tighten the strap.</p><p><strong>Now you've solved one problem by creating another.</strong></p>",
        "image": "shopify://shop_images/ps-s02-problem.jpg",
        "fallback_media": 7,
        "image_alt": "Side-by-side comparison: an ordinary flat mask letting light in near the nose, and the Pillow-Side contoured mask sitting flush against the pillow",
        "background": "cream",
        "spacing": "lg"
      }
    },
