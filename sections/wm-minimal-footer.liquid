<footer class="wm-local-footer" role="contentinfo">
  <div class="wm-local-footer__inner">
    <div class="wm-local-footer__top">
      <div class="wm-local-footer__brand-block">
        <a class="wm-local-footer__brand" href="{{ routes.root_url }}" aria-label="Nubrae home">
          <img
            src="{{ 'nubraetm-wordmark.svg' | asset_url }}"
            class="wm-local-footer__logo"
            alt="Nubrae™"
            width="560"
            height="150"
            loading="lazy"
          >
        </a>
        <p>Make the mattress you're keeping more comfortable.</p>
      </div>

      <nav class="wm-local-footer__nav" aria-label="Footer navigation">
        <div class="wm-local-footer__column">
          <strong>CloudLoft</strong>
          <a href="#MainContent">Shop CloudLoft</a>
          <a href="#proof-2">How it works</a>
          <a href="#proof-3">Three tests</a>
          <a href="#proof-4">Guarantee</a>
        </div>

        <div class="wm-local-footer__column">
          <strong>Help</strong>
          <a href="#MainContent">Sizing &amp; fit</a>
          <a href="{{ routes.cart_url }}">Your bag</a>
          {% if shop.refund_policy %}<a href="{{ shop.refund_policy.url }}">Returns</a>{% endif %}
          {% if shop.shipping_policy %}<a href="{{ shop.shipping_policy.url }}">Shipping</a>{% endif %}
        </div>

        <div class="wm-local-footer__column">
          <strong>Policies</strong>
          {% if shop.privacy_policy %}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{% endif %}
          {% if shop.terms_of_service %}<a href="{{ shop.terms_of_service.url }}">Terms</a>{% endif %}
          {% if shop.refund_policy %}<a href="{{ shop.refund_policy.url }}">Refund policy</a>{% endif %}
        </div>
      </nav>
    </div>

    <div class="wm-local-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} Nubrae™. All rights reserved.</span>
      <span>CloudLoft Mattress Topper</span>
    </div>
  </div>
</footer>

{% style %}
  html.wm-product-template .shopify-section-group-footer-group,
  body.wm-product-template .shopify-section-group-footer-group{display:none!important}
  .wm-local-footer{background:#00304E;color:#fff;border-top:1px solid rgba(255,255,255,.12)}
  .wm-local-footer__inner{width:min(1240px,calc(100% - 40px));margin:0 auto;padding:64px 0 26px}
  .wm-local-footer__top{display:grid;grid-template-columns:minmax(260px,1fr) minmax(520px,1.45fr);gap:80px;align-items:start}
  .wm-local-footer__brand{display:inline-flex;align-items:center;text-decoration:none}
  .wm-local-footer__logo{display:block;width:auto;height:46px;max-width:190px;filter:brightness(0) invert(1)}
  .wm-local-footer__brand-block p{max-width:330px;margin:18px 0 0;color:#c8d7df;font-size:14px;line-height:1.6}
  .wm-local-footer__nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:34px}
  .wm-local-footer__column{display:grid;align-content:start;gap:11px}
  .wm-local-footer__column strong{margin-bottom:3px;color:#fff;font-size:11px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
  .wm-local-footer__column a{width:max-content;max-width:100%;color:#c8d7df;text-decoration:none;font-size:13px;line-height:1.45;transition:color .18s ease}
  .wm-local-footer__column a:hover{color:#fff}
  .wm-local-footer__bottom{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:54px;padding-top:22px;border-top:1px solid rgba(255,255,255,.14);color:#9fb5c1;font-size:11px;line-height:1.5}
  @media(max-width:900px){.wm-local-footer__top{grid-template-columns:1fr;gap:42px}.wm-local-footer__nav{max-width:650px}}
  @media(max-width:640px){.wm-local-footer__inner{width:calc(100% - 30px);padding:46px 0 22px}.wm-local-footer__logo{height:40px;max-width:165px}.wm-local-footer__nav{grid-template-columns:1fr 1fr;gap:34px 24px}.wm-local-footer__bottom{align-items:flex-start;flex-direction:column;margin-top:40px;gap:6px}.wm-local-footer__column:last-child{grid-column:1/-1}}
{% endstyle %}

{% schema %}
{
  "name":"Nubrae landing footer",
  "tag":"section",
  "class":"section-wm-minimal-footer",
  "settings":[],
  "presets":[{"name":"Nubrae landing footer"}]
}
{% endschema %}
