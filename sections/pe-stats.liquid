{% if section.settings.enabled %}
<section class="pe-section pe-section--soft">
  <div class="pe-shell">
    <div class="pe-heading pe-heading--center">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}<p>{{ section.settings.intro }}</p>{% endif %}
    </div>
    <div class="pe-stats">
      {% for block in section.blocks %}
        <div class="pe-stat" {{ block.shopify_attributes }}>
          <strong>{{ block.settings.value }}{{ block.settings.suffix }}</strong>
          <span>{{ block.settings.label }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
{% schema %}
{"name":"PE stats","settings":[
{"type":"checkbox","id":"enabled","label":"Show section","default":false},
{"type":"text","id":"heading","label":"Heading","default":"Proof you can substantiate"},
{"type":"textarea","id":"intro","label":"Intro","default":"Enable this section only when you have real supporting data."}
],"blocks":[{"type":"stat","name":"Statistic","limit":4,"settings":[
{"type":"text","id":"value","label":"Value"},
{"type":"text","id":"suffix","label":"Suffix"},
{"type":"text","id":"label","label":"Label","default":"Add supporting statistic"}
]}],"presets":[{"name":"PE stats"}]}
{% endschema %}